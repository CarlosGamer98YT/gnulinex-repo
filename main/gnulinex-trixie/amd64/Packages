  * Traversable
    - Iterable
         + Collection
           # List
             * BidirList
           # Set
             * SortedSet
               - BidirSortedSet
           # MultiSet
           # Queue
             * Deque
         + Map
           # SortedMap
             * BidirSortedMap
    - Iterator
         + BidirIterator
           # BidirListIterator
         + ListIterator
           # BidirListIterator
  * MultiMap
  * Future
 .
